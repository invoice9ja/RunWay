# RunWay MCP server configuration

# --- Chain -------------------------------------------------------------------
# Arc testnet. Use the mainnet RPC and chain id for mainnet.
ARC_TESTNET_RPC=https://rpc.testnet.arc.network
RUNWAY_CHAIN_ID=5042002
RUNWAY_NETWORK=arc-testnet

# Optional overrides; the SDK defaults these to the Arc testnet deployment.
# RUNWAY_USDC=0x3600000000000000000000000000000000000000
# RUNWAY_FACTORY=0xc8f5ae45cfbc7a9f17248fd610adc989f8d08106
# RUNWAY_VAULT=0x30f5f5d45bbf94487fa3cae069d5bdaadb6744ab

# --- Agent -------------------------------------------------------------------
# The agent's operational key. Needs AGENT_ROLE on the splitter to settle and
# withdraw. It does NOT need UNDERWRITER_ROLE - advances are approved by the
# hosted underwriter, never by the borrower.
AGENT_PRIVATE_KEY=0x...

# Default splitter for this agent (so tools can omit `splitter`).
RUNWAY_SPLITTER=0x...

# --- Hosted underwriter ------------------------------------------------------
# The endpoint that scores and opens advances. Without it,
# runway_request_advance returns a clear error instead of opening a loan.
RUNWAY_UNDERWRITER_URL=
RUNWAY_UNDERWRITER_SECRET=