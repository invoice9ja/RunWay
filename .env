# Arc Mainnet Configuration
ARC_MAINNET_RPC=https://arc-mainnet.g.alchemy.com/v2/***REDACTED_ALCHEMY_KEY***
ARC_MAINNET_CHAIN_ID=5042
ARC_TESTNET_RPC=https://rpc.testnet.arc.io
ARC_TESTNET_CHAIN_ID=5042002

# USDC on Arc (native USDC gas token + ERC-20 interface)
USDC_ADDRESS=0x3600000000000000000000000000000000000000
USDC_DECIMALS=6

# Deployment
PRIVATE_KEY=***REDACTED_DEPLOYER_KEY***
ADMIN_ADDRESS=0x...  # Will be derived from private key
UNDERWRITER_ADDRESS=0x...  # Same as admin for MVP
WATCHER_ADDRESS=0x...  # Same as admin for MVP

# Explorer Verification (no API key provided)
ARC_EXPLORER_API_KEY=
ARC_MAINNET_EXPLORER_URL=https://explorer.arc.io

# Vault Parameters
GLOBAL_MAX=10000000000  # 10,000 USDC (6 decimals)
STARTER_CAP=500000000  # 500 USDC
FEE_BPS_DEFAULT=800  # 8%
SHARE_BPS_DEFAULT=3000  # 30%
DUE_DAYS_DEFAULT=30

# Services
KEEPER_INTERVAL_MS=300000  # 5 minutes
SETTLE_THRESHOLD_USDC=1000000  # 1 USDC minimum to trigger settle
WATCHER_INTERVAL_MS=300000  # 5 minutes
UNDERWRITER_SCHEDULE_CRON="0 2 * * *"  # Daily at 2 AM UTC

# Demo Seller/Buyer
DEMO_SELLER_PORT=3001
DEMO_BUYER_INTERVAL_MS=60000  # 1 minute between demo payments
DEMO_PAYMENT_AMOUNT_USDC=100000  # 0.1 USDC per demo payment

# Database (Supabase) - optional for MVP
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# AI (Anthropic Claude for underwriter) - optional for MVP
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Dashboard
NEXT_PUBLIC_DASHBOARD_URL=https://runway-dashboard.vercel.app
NEXT_PUBLIC_ARC_EXPLORER_URL=https://explorer.arc.io