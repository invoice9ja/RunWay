{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "regions": [
    "iad1"
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/status.ts": {
      "maxDuration": 60
    },
    "api/keeper.ts": {
      "maxDuration": 60
    },
    "api/demo/buy.ts": {
      "maxDuration": 60
    },
    "api/x402/resource.ts": {
      "maxDuration": 60
    },
    "api/demo/sell.ts": {
      "maxDuration": 60
    },
    "api/tests/run.ts": {
      "maxDuration": 60
    },
    "api/demo/sell-x402.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/keeper?auto=1",
      "schedule": "0 12 * * *"
    }
  ],
  "env": {
    "RUNWAY_NETWORK": "arc-testnet",
    "RUNWAY_CHAIN_ID": "5042002",
    "RUNWAY_RPC_URL": "https://rpc.testnet.arc.network",
    "RUNWAY_EXPLORER_URL": "https://explorer.testnet.arc.io",
    "RUNWAY_USDC_ADDRESS": "0x3600000000000000000000000000000000000000",
    "RUNWAY_VAULT_ADDRESS": "0x0f1a59fcab0638a1f3525d5acaedc5cbef4d95b7",
    "RUNWAY_FACTORY_ADDRESS": "0x0ed2b25c82f8a701f81c5182c0a5f3faf6e53c76",
    "RUNWAY_SPLITTER_ADDRESS": "0x8C24a83a1103460a0845bE553fe070040f8c31D1",
    "RUNWAY_SETTLE_THRESHOLD": "100000",
    "RUNWAY_DEMO_PRICE": "100000"
  }
}
