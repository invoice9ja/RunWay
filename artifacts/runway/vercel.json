{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "regions": [
    "iad1"
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/status.ts": {
      "maxDuration": 60
    },
    "api/keeper.ts": {
      "maxDuration": 60
    },
    "api/demo/buy.ts": {
      "maxDuration": 60
    },
    "api/x402/resource.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/keeper?auto=1",
      "schedule": "0 12 * * *"
    }
  ],
  "env": {
    "RUNWAY_NETWORK": "arc-testnet",
    "RUNWAY_CHAIN_ID": "5042002",
    "RUNWAY_RPC_URL": "https://rpc.testnet.arc.network",
    "RUNWAY_EXPLORER_URL": "https://explorer.testnet.arc.io",
    "RUNWAY_USDC_ADDRESS": "0x3600000000000000000000000000000000000000",
    "RUNWAY_VAULT_ADDRESS": "0xc9497Ec40951FbB98C02c666b7F9Fa143678E2Be",
    "RUNWAY_FACTORY_ADDRESS": "0x62F0bE8a94F7E348f15f6F373E35Ae5c34F7d40F",
    "RUNWAY_SPLITTER_ADDRESS": "0x06cebc9403c00d972e014e452509d04c7c350880",
    "RUNWAY_SETTLE_THRESHOLD": "100000",
    "RUNWAY_DEMO_PRICE": "100000"
  }
}
