{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "regions": [
    "iad1"
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/status.ts": {
      "maxDuration": 60
    },
    "api/keeper.ts": {
      "maxDuration": 60
    },
    "api/demo/buy.ts": {
      "maxDuration": 60
    },
    "api/x402/resource.ts": {
      "maxDuration": 60
    },
    "api/demo/sell.ts": {
      "maxDuration": 60
    },
    "api/tests/run.ts": {
      "maxDuration": 60
    },
    "api/demo/sell-x402.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/keeper?auto=1",
      "schedule": "0 12 * * *"
    }
  ],
  "env": {
    "RUNWAY_NETWORK": "arc-testnet",
    "RUNWAY_CHAIN_ID": "5042002",
    "RUNWAY_RPC_URL": "https://rpc.testnet.arc.network",
    "RUNWAY_EXPLORER_URL": "https://explorer.testnet.arc.io",
    "RUNWAY_USDC_ADDRESS": "0x3600000000000000000000000000000000000000",
    "RUNWAY_VAULT_ADDRESS": "0x30f5f5d45bbf94487fa3cae069d5bdaadb6744ab",
    "RUNWAY_FACTORY_ADDRESS": "0xc8f5ae45cfbc7a9f17248fd610adc989f8d08106",
    "RUNWAY_SPLITTER_ADDRESS": "0x96559D62bAD82F31853F3dd1b6C3c3ef9F434279",
    "RUNWAY_SETTLE_THRESHOLD": "100000",
    "RUNWAY_DEMO_PRICE": "100000"
  }
}
