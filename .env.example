# Arc Network Configuration
ARC_TESTNET_RPC=https://rpc.testnet.arc.xyz
ARC_MAINNET_RPC=https://rpc.arc.xyz
ARC_TESTNET_CHAIN_ID=12345
ARC_MAINNET_CHAIN_ID=12345

# USDC on Arc (native USDC, not bridged)
USDC_ADDRESS=0x...  # Fill in from Arc docs
USDC_DECIMALS=6

# Deployment
PRIVATE_KEY=0x...  # Deployer private key
ADMIN_ADDRESS=0x...  # Admin address (gets DEFAULT_ADMIN_ROLE)
UNDERWRITER_ADDRESS=0x...  # Underwriter address (gets UNDERWRITER_ROLE)
WATCHER_ADDRESS=0x...  # Watcher address (gets WATCHER_ROLE)

# Explorer Verification
ARC_EXPLORER_API_KEY=...  # Arc explorer API key
ARC_TESTNET_EXPLORER_URL=https://explorer.testnet.arc.xyz
ARC_MAINNET_EXPLORER_URL=https://explorer.arc.xyz

# Vault Parameters
GLOBAL_MAX=10000000000  # 10,000 USDC (6 decimals)
STARTER_CAP=500000000  # 500 USDC
FEE_BPS_DEFAULT=800  # 8%
SHARE_BPS_DEFAULT=3000  # 30%
DUE_DAYS_DEFAULT=30

# Services
KEEPER_INTERVAL_MS=300000  # 5 minutes
SETTLE_THRESHOLD_USDC=1000000  # 1 USDC minimum to trigger settle
WATCHER_INTERVAL_MS=300000  # 5 minutes
UNDERWRITER_SCHEDULE_CRON="0 2 * * *"  # Daily at 2 AM UTC

# Demo Seller/Buyer
DEMO_SELLER_PORT=3001
DEMO_BUYER_INTERVAL_MS=60000  # 1 minute between demo payments
DEMO_PAYMENT_AMOUNT_USDC=100000  # 0.1 USDC per demo payment

# Database (Supabase)
SUPABASE_URL=https://...supabase.co
SUPABASE_SERVICE_KEY=...
SUPABASE_ANON_KEY=...

# AI (Anthropic Claude for underwriter)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Dashboard
NEXT_PUBLIC_DASHBOARD_URL=https://runway-dashboard.vercel.app
NEXT_PUBLIC_ARC_EXPLORER_URL=https://explorer.arc.xyz