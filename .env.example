# Copy to .env and fill in. Never commit .env; the pre-commit hook rejects it.
#
# KEY STORAGE: every operational key lives here and nowhere else. Do not stash
# keys in /tmp or any other scratch directory; those get cleaned and the role
# holder becomes unreachable, which strands whatever it controls. A role granted
# on chain whose key is gone is unrecoverable without the admin.

# --- RPC ---
# Arc testnet has a public endpoint; an Alchemy key is optional.
ARC_TESTNET_RPC=https://rpc.testnet.arc.network
ARC_MAINNET_RPC=

# --- Deployer / admin ---
# Moves funds, pauses the vault, registers splitters. Holds the vault
# DEFAULT_ADMIN_ROLE, which is what makes a lost agent key recoverable.
# Also the demo payer on testnet.
PRIVATE_KEY=

# --- Separated service keys ---
# Four distinct accounts, so a compromised scorer cannot move funds and a
# compromised flagger cannot originate credit. Addresses in
# deployed-testnet.json.
#
# WATCHER_PRIVATE_KEY      holds WATCHER_ROLE, calls flagLoan
# UNDERWRITER_PRIVATE_KEY  holds UNDERWRITER_ROLE, calls openLoan
# AGENT_PRIVATE_KEY        owns a splitter: DEFAULT_ADMIN_ROLE + AGENT_ROLE
# RUNWAY_PRIVATE_KEY       holds no vault role; signs EIP-3009 payments only
#
# Each needs gas to send a transaction. 1 native is plenty on testnet.
UNDERWRITER_PRIVATE_KEY=
WATCHER_PRIVATE_KEY=
AGENT_PRIVATE_KEY=
RUNWAY_PRIVATE_KEY=

# Arc testnet runs Blockscout and verifies keyless, so there is no explorer key to
# set. forge defaults to the Etherscan verifier and will insist on one; pass
# --verifier blockscout --verifier-url https://explorer.testnet.arc.io/api/ instead.
# Use explorer.testnet.arc.io, not testnet.arcscan.app, which 301s.
ARC_EXPLORER_API_KEY=

# --- Dashboard (artifacts/runway) ---
RUNWAY_NETWORK=arc-testnet
RUNWAY_CHAIN_ID=5042002
RUNWAY_RPC_URL=https://rpc.testnet.arc.network
RUNWAY_EXPLORER_URL=https://explorer.testnet.arc.io
RUNWAY_USDC_ADDRESS=0x3600000000000000000000000000000000000000
RUNWAY_VAULT_ADDRESS=0x30f5f5d45bbf94487fa3cae069d5bdaadb6744ab
RUNWAY_FACTORY_ADDRESS=0xc8f5ae45cfbc7a9f17248fd610adc989f8d08106
RUNWAY_SPLITTER_ADDRESS=0x96559D62bAD82F31853F3dd1b6C3c3ef9F434279
RUNWAY_SETTLE_THRESHOLD=100000
RUNWAY_DEMO_PRICE=100000

# Role holders, as addresses only. The hosted negative tests simulate from
# these so they exercise the guard under test instead of reverting at the
# access-control gate. simulateContract reads state and never signs, so these
# are addresses and not keys by design.
RUNWAY_ADMIN_ADDRESS=0xe81e8078f2D284C92D6d97B5d4769af81e0cA11C
RUNWAY_UNDERWRITER_ADDRESS=0xa03D9bA207EE0D6F161bcd8E7F6B1d618F670813
RUNWAY_WATCHER_ADDRESS=0x73Ff6742FF497cb9f282607ca5C827626F426a19
RUNWAY_AGENT_ADDRESS=0xa0aE5469b0f97BccFDD605E7862dEbfe37f03257

# Guards /api/keeper and /api/demo/buy from being triggered by anyone.
# Keep a local copy: a secret that exists only on Vercel cannot be read back,
# which makes the authed endpoints untestable and unrecoverable.
RUNWAY_KEEPER_SECRET=

# --- Chain selection (services/watcher, services/underwriter) ---
# Both services resolve the chain from this and verify the RPC actually serves
# it via eth_chainId. They previously hardcoded Arc testnet, so pointing them
# at mainnet failed with an opaque ethers network error. To run on mainnet set
# RUNWAY_CHAIN_ID=5042, RUNWAY_NETWORK=arc-mainnet, and RUNWAY_RPC_URL.
RUNWAY_CHAIN_ID=5042002
RUNWAY_NETWORK=arc-testnet
RUNWAY_RPC_URL=https://rpc.testnet.arc.network

# --- Watcher (services/watcher) ---
# Key holding the vault's WATCHER_ROLE. Deliberately separate from the
# underwriter key so a compromised scorer cannot flag at will.
WATCHER_INTERVAL_MS=60000
# Outstanding debt as a fraction of lifetime revenue that reads as wash trading.
WATCHER_INFLATION_RATIO=0.9
# Comma-separated splitters the watcher may flag. Empty means report only.
WATCHER_ALLOW=

# --- Underwriter (services/underwriter) ---
UNDERWRITER_SPLITTER=
UNDERWRITER_PRINCIPAL=10000000
UNDERWRITER_MIN_SCORE=60
# Set to false to actually call openLoan. Keep true until reviewed.
UNDERWRITER_DRY_RUN=true
# Optional LLM scoring pass; falls back to the rules engine when unset.
UNDERWRITER_LLM_ENDPOINT=
UNDERWRITER_LLM_API_KEY=
UNDERWRITER_LLM_MODEL=gpt-4o-mini